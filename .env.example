# 必填
BOT_TOKEN=123456789:请替换为真实令牌
ADMIN_IDS=123456789,987654321

# 留空使用长轮询；设置 Webhook 公网地址时必须同时设置至少 8 位密钥
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=
WEB_HOST=0.0.0.0
WEB_PORT=8080

# 额外的用户编号下限，默认关闭数值过滤；它不代表可靠的注册年龄
ACCOUNT_AGE_GATE=true
MIN_USER_ID=0

# 古诗词答题固定启用，内置50题，每场最多答错5次，无需额外配置
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
TZ=Asia/Shanghai
LOG_LEVEL=INFO
DROP_PENDING_UPDATES=false
